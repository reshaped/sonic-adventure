/build/
/orig/*
!/orig/.gitkeep
/tools/wibo-*
/tools/shc-*
/tools/llvm
/tools/sh-elf*
/tools/sh4zam

# Python's bytecode from a tool run outside make, which puts it in build/
__pycache__/

# disc files stay out of git, wherever they land
*.[Bb][Ii][Nn]
*.[Pp][Rr][Ss]
*.[Dd][Rr][Vv]
*.[Gg][Dd][Ii]
*.[Rr][Aa][Ww]

# the Xbox host's build outputs (nxdk): objects, dependency files, the XBE,
# its map and the generated DSP program
*.obj
*.c.d
*.cpp.d
/xbox/host/xbox/bin/
/xbox/host/xbox/build/
/xbox/host/xbox/main.exe
/xbox/host/xbox/main.map
/xbox/host/xbox/.sound_*
/xbox/host/xbox/probe/bin/
/xbox/host/xbox/probe/main.exe
/xbox/host/xbox/probe/probe.iso

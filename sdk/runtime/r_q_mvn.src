        .EXPORT     __quick_mvn

        .SECTION    P,CODE,ALIGN=4

; copy R0 bytes from R2 to R1. R0 is a multiple of 4, and the two blocks are
; word aligned and don't overlap. above 64 bytes, the copy loop also reads the
; word after the source, so that word must be readable. it changes R0 and T,
; R1 too above 64 bytes, and no other register
; @asm open: no inspect rule reads R0 at its entry
__quick_mvn:
        MOV.L       R3,@-R15
        MOV         #64,R3
        CMP/HS      R0,R3
        BF          mvn_copy_loop_entry
        MOV.L       mvn_copy_table_address,R3
        MOV.L       @(R0,R3),R3
        JMP         @R3
        NOP
mvn_copy_table_address:
        .DATA.L     mvn_copy_table
; unreached: the copy table enters at mvn_words_16 and the labels below it
        NOP
mvn_words_16:
        MOV.L       @(60,R2),R0
        MOV.L       R0,@(60,R1)
mvn_words_15:
        MOV.L       @(56,R2),R0
        MOV.L       R0,@(56,R1)
mvn_words_14:
        MOV.L       @(52,R2),R0
        MOV.L       R0,@(52,R1)
mvn_words_13:
        MOV.L       @(48,R2),R0
        MOV.L       R0,@(48,R1)
mvn_words_12:
        MOV.L       @(44,R2),R0
        MOV.L       R0,@(44,R1)
mvn_words_11:
        MOV.L       @(40,R2),R0
        MOV.L       R0,@(40,R1)
mvn_words_10:
        MOV.L       @(36,R2),R0
        MOV.L       R0,@(36,R1)
mvn_words_9:
        MOV.L       @(32,R2),R0
        MOV.L       R0,@(32,R1)
mvn_words_8:
        MOV.L       @(28,R2),R0
        MOV.L       R0,@(28,R1)
mvn_words_7:
        MOV.L       @(24,R2),R0
        MOV.L       R0,@(24,R1)
mvn_words_6:
        MOV.L       @(20,R2),R0
        MOV.L       R0,@(20,R1)
mvn_words_5:
        MOV.L       @(16,R2),R0
        MOV.L       R0,@(16,R1)
mvn_words_4:
        MOV.L       @(12,R2),R0
        MOV.L       R0,@(12,R1)
mvn_words_3:
        MOV.L       @(8,R2),R0
        MOV.L       R0,@(8,R1)
mvn_words_2:
        MOV.L       @(4,R2),R0
        MOV.L       R0,@(4,R1)
mvn_words_1:
        MOV.L       @R2,R0
        MOV.L       R0,@R1
mvn_done:
        RTS
        MOV.L       @R15+,R3
        .ALIGN      4
mvn_copy_table:
        .DATA.L     mvn_done
        .DATA.L     mvn_words_1
        .DATA.L     mvn_words_2
        .DATA.L     mvn_words_3
        .DATA.L     mvn_words_4
        .DATA.L     mvn_words_5
        .DATA.L     mvn_words_6
        .DATA.L     mvn_words_7
        .DATA.L     mvn_words_8
        .DATA.L     mvn_words_9
        .DATA.L     mvn_words_10
        .DATA.L     mvn_words_11
        .DATA.L     mvn_words_12
        .DATA.L     mvn_words_13
        .DATA.L     mvn_words_14
        .DATA.L     mvn_words_15
        .DATA.L     mvn_words_16
mvn_copy_loop_entry:
        MOV.L       R2,@-R15
        MOV         R2,R3
        ADD         R0,R3
mvn_copy_loop:
        MOV.L       @R2+,R0
        CMP/HS      R2,R3
        BF          mvn_copy_done
        MOV.L       R0,@R1
        MOV.L       @R2+,R0
        CMP/HS      R2,R3
        BF          mvn_copy_done
        MOV.L       R0,@(4,R1)
        BRA         mvn_copy_loop
        ADD         #8,R1
mvn_copy_done:
        MOV.L       @R15+,R2
        RTS
        MOV.L       @R15+,R3
        .END

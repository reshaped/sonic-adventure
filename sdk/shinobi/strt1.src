        .SECTION    DSGNJ13,DATA,ALIGN=4
        .SECTION    DSGNJ14,DATA,ALIGN=4
        .SECTION    DSGNJ15,DATA,ALIGN=4
        .SECTION    PSGMW00,CODE,ALIGN=4
        .SECTION    PSGMW01,CODE,ALIGN=4
        .SECTION    PSGMW02,CODE,ALIGN=4
        .SECTION    PSGMW03,CODE,ALIGN=4
        .SECTION    PSGMW04,CODE,ALIGN=4
        .SECTION    PSGMW05,CODE,ALIGN=4
        .SECTION    PSGMW06,CODE,ALIGN=4
        .SECTION    PSGMW07,CODE,ALIGN=4
        .SECTION    PSGMW08,CODE,ALIGN=4
        .SECTION    PSGMW09,CODE,ALIGN=4
        .SECTION    PSGMW10,CODE,ALIGN=4
        .SECTION    PSGMW11,CODE,ALIGN=4
        .SECTION    PSGMW12,CODE,ALIGN=4
        .SECTION    PSGMW13,CODE,ALIGN=4
        .SECTION    PSGMW14,CODE,ALIGN=4
        .SECTION    PSGMW15,CODE,ALIGN=4
        .SECTION    DSGMW00,DATA,ALIGN=4
        .SECTION    DSGMW01,DATA,ALIGN=4
        .SECTION    DSGMW02,DATA,ALIGN=4
        .SECTION    DSGMW03,DATA,ALIGN=4
        .SECTION    DSGMW04,DATA,ALIGN=4
        .SECTION    DSGMW05,DATA,ALIGN=4
        .SECTION    DSGMW06,DATA,ALIGN=4
        .SECTION    DSGMW07,DATA,ALIGN=4
        .SECTION    DSGMW08,DATA,ALIGN=4

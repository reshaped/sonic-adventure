        .SECTION    DUSER3,DATA,ALIGN=4
        .SECTION    B,DATA,ALIGN=4
        .SECTION    B32,DATA,ALIGN=32
        .SECTION    BSG,DATA,ALIGN=4
        .SECTION    BSG32,DATA,ALIGN=32
        .END

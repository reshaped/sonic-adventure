; the program's entry, its module's start and end records, and the tables
; that give where its sections start and end

        .IMPORT     __INIT
        .EXPORT     _START_SYS
        .EXPORT     _crt0

        .SECTION    DSGLH,DATA,ALIGN=4

; void START_SYS(void)
; the program's entry. it sets CCR.ICI, which invalidates the instruction
; cache, and clears the bits CCR doesn't define. it then jumps to _INIT
; through jump_to_init. its code lies in DSGLH, a data section, before the
; start record's ID at 0x8c010030
; @asm open: no inspect rule reads its code in the DATA section DSGLH
_START_SYS:
; void crt0(void)
; START_SYS, by a second name
_crt0:
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
START:
        MOV.L       ccr_address,R0
        MOV.L       @R0,R1
        MOV.L       ccr_defined_bits,R2
        AND         R2,R1
        MOV.W       ccr_ici,R2
        OR          R2,R1
        MOV.L       R1,@R0
        MOV.L       jump_to_init_address,R0
        JMP         @R0
        NOP
ccr_ici:
        .DATA.W     H'0800
        .ALIGN      4
ccr_address:
        .DATA.L     H'FF00001C
ccr_defined_bits:
        .DATA.L     H'000089AF          ; every bit CCR defines
jump_to_init_address:
        .DATA.L     jump_to_init
; the start record's ID, which ovMdlEntryTbl finds at the module's offset
; 0x30. the library handles follow it, up to the end record
        .SDATA      "Lib Handle Start"

        .SECTION    DSGLE,DATA,ALIGN=4

; the end record: four zero words, then its ID
        .DATA.L     0,0,0,0
        .SDATA      "Lib Handle End  "

        .SECTION    P,CODE,ALIGN=4

; void jump_to_init(void)
; @asm open: every instruction is one SHC writes for C
jump_to_init:
        MOV.L       init_address,R0
        JMP         @R0
        NOP
        .ALIGN      4
init_address:
        .DATA.L     __INIT

        .SECTION    C,DATA,ALIGN=4

__D_ROM:
        .DATA.L     (STARTOF D)
__D32_ROM:
        .DATA.L     (STARTOF D32)
__D_BGN:
        .DATA.L     (STARTOF R)
__D4_END:
        .DATA.L     (STARTOF R)+(SIZEOF R)
__D32_BGN:
        .DATA.L     (STARTOF R32)
__D_END:
        .DATA.L     (STARTOF R32)+(SIZEOF R32)
__B_BGN:
        .DATA.L     (STARTOF B)
__B4_END:
        .DATA.L     (STARTOF B)+(SIZEOF B)
__B32_BGN:
        .DATA.L     (STARTOF B32)
__B_END:
        .DATA.L     (STARTOF B32)+(SIZEOF B32)

        .SECTION    C32,DATA,ALIGN=32
        .SECTION    D,DATA,ALIGN=4
        .SECTION    D32,DATA,ALIGN=32
        .SECTION    R,DATA,ALIGN=4
        .SECTION    R32,DATA,ALIGN=32
        .SECTION    PSG,CODE,ALIGN=4

        .SECTION    CSG,DATA,ALIGN=4

__DSGLH_BGN:
        .DATA.L     (STARTOF DSGLH)
__DSGLH_END:
        .DATA.L     (STARTOF DSGLH)+(SIZEOF DSGLH)
__DSGLE_BGN:
        .DATA.L     (STARTOF DSGLE)
__DSGLE_END:
        .DATA.L     (STARTOF DSGLE)+(SIZEOF DSGLE)
__DSG_ROM:
        .DATA.L     (STARTOF DSG)
__DSG32_ROM:
        .DATA.L     (STARTOF DSG32)
__DSG_BGN:
        .DATA.L     (STARTOF RSG)
__DSG4_END:
        .DATA.L     (STARTOF RSG)+(SIZEOF RSG)
__DSG32_BGN:
        .DATA.L     (STARTOF RSG32)
__DSG_END:
        .DATA.L     (STARTOF RSG32)+(SIZEOF RSG32)
__BSG_BGN:
        .DATA.L     (STARTOF BSG)
__BSG4_END:
        .DATA.L     (STARTOF BSG)+(SIZEOF BSG)
__BSG32_BGN:
        .DATA.L     (STARTOF BSG32)
__BSG_END:
        .DATA.L     (STARTOF BSG32)+(SIZEOF BSG32)

        .SECTION    CSG32,DATA,ALIGN=32
        .SECTION    DSG,DATA,ALIGN=4
        .SECTION    DSG32,DATA,ALIGN=32
        .SECTION    RSG,DATA,ALIGN=4
        .SECTION    RSG32,DATA,ALIGN=32
        .SECTION    PSGNJ00,CODE,ALIGN=4
        .SECTION    PSGNJ01,CODE,ALIGN=4
        .SECTION    PSGNJ02,CODE,ALIGN=4
        .SECTION    PSGNJ03,CODE,ALIGN=4
        .SECTION    PSGNJ04,CODE,ALIGN=4

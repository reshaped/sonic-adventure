; void point_project_centered(NJS_POINT3 *pos, NJS_POINT3 *out)
; project pos, in view space, onto the screen, from the screen's center.
; out->x and out->y are pos->x and pos->y times the screen's distance and
; Ninja's aspect for their axis, over pos->z. out->z is pos->z. asmsh writes
; the pool past the RTS's slot, and the zero word at 0x8c08af1e aligns it
; @asm open: every instruction is one SHC writes for C
_point_project_centered:
        MOV.L       #__nj_screen_,R1
        FMOV.S      @R1,FR4                 ; dist
        MOV         #8,R0
        FMOV.S      @(R0,R4),FR3
        ADD         #12,R5
        FMOV.S      FR3,@-R5
        FDIV        FR3,FR4
        FMOV.S      @R4+,FR1
        FMOV.S      @R4+,FR2
        MOV.L       #__nj_scr_aspect_y_,R1
        FMOV.S      @R1,FR0
        FMUL        FR4,FR0
        FMUL        FR2,FR0
        FMOV.S      FR0,@-R5
        MOV.L       #__nj_scr_aspect_x_,R1
        FMOV.S      @R1,FR0
        FMUL        FR4,FR0
        FMUL        FR1,FR0
        FMOV.S      FR0,@-R5
        RTS
        NOP

; Float float_mod(Float x, Float y)
; return x - y * trunc(x / y), or 0 when y is 0
; @asm open: every instruction is one SHC writes for C
_float_mod:
        FLDI0       FR0
        FCMP/EQ     FR5,FR0
        BT          ?none
        FMOV.S      FR4,FR0
        FDIV        FR5,FR4
        FTRC        FR4,FPUL
        STS         FPUL,R0
        LDS         R0,FPUL
        FLOAT       FPUL,FR4
        FMUL        FR5,FR4
        RTS
        FSUB        FR4,FR0
?none:
        RTS
        NOP

; Angle angle_arc_sin(Float sine)
; return the angle whose sine is sine, from -QUARTER to QUARTER, by
; _asin_table. it runs on into _angle_from_table with R5 at the table's
; middle entry
; @asm open: every instruction is one SHC writes for C
_angle_arc_sin:
        MOV.L       #_asin_table+512,R5

; return the angle for FR4, from -1 to 1, in the 513-entry table whose
; middle entry R5 points to. FR4 times 256, truncated toward 0, picks an
; entry n. the result adds to entry n the step to entry n + 1, times the
; fraction the truncation dropped. that fraction keeps FR4's sign, and the
; product truncates toward 0. an FR4 of 1 reads the word past the table,
; which a fraction of 0 scales away
; @asm open: every instruction is one SHC writes for C
_angle_from_table:
        FMOV.S      FR4,FR3
        MOVA        ?steps,R0
        FMOV.S      @R0,FR1
        FMUL        FR3,FR1
        FTRC        FR1,FPUL
        STS         FPUL,R1
        LDS         R1,FPUL
        FLOAT       FPUL,FR0
        FSUB        FR0,FR1
        MOV         R1,R3
        SHLL        R3
        MOV         R5,R0
        MOV.W       @(R0,R3),R1
        ADD         #2,R3
        MOV.W       @(R0,R3),R2
        SUB         R1,R2
        LDS         R2,FPUL
        FLOAT       FPUL,FR2
        FMUL        FR1,FR2
        FTRC        FR2,FPUL
        STS         FPUL,R0
        RTS
        ADD         R1,R0
?steps:
        .FDATA.S    F'256.0
; the angle whose sine is n/256, for n from -256 to 256
_asin_table:
        .DATA.W     H'C000,H'C39B,H'C51A,H'C63F,H'C737,H'C812,H'C8D8,H'C98E

; Angle angle_arc_cos(Float cosine)
; return the angle whose cosine is cosine, from 0 to HALF, by ?acos_table,
; but -HALF for a cosine of -1: the MOV.W that reads the table's first
; entry, H'8000, extends its sign. ?acos_table's 513 angles, at 0x8c08b38c,
; lie inside the function. the MOVA at 0x8c08b384 addresses their middle
; entry, at 0x8c08b58c, for _angle_from_table
; @asm open: every instruction is one SHC writes for C
_angle_arc_cos:
        MOVA        ?acos_table+512,R0
        BRA         _angle_from_table
        MOV         R0,R5
        .ALIGN      4
; the angle whose cosine is n/256, for n from -256 to 256
?acos_table:
        .DATA.W     H'8000,H'7C66,H'7AE7,H'79C2,H'78CA,H'77EF,H'7729,H'7673

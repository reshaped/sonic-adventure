; void point_calc_xy(NJS_MATRIX *matrix, NJS_POINT3 *point, Float *out)
; write to out[0] and out[1] the x and y of (point->x, point->y, 0, 1)
; times matrix. a NULL matrix takes XMTRX as it stands
; @asm operand: fipr-registers, FIPR FV0,FV4 at 0x8c08b7b4 and 0x8c08b7c4
_point_calc_xy:
        FMOV.S      @R5+,FR0
        TST         R4,R4
        FMOV.S      @R5+,FR1
        FLDI0       FR2
        BF/S        ?matrix
        FLDI1       FR3
        FTRV        XMTRX,FV0
        ADD         #8,R6
        FMOV.S      FR1,@-R6
        RTS
        FMOV.S      FR0,@-R6
        .ALIGN      4
?matrix:
        MOV         #0,R0
        FMOV.S      @(R0,R4),FR4
        MOV         #16,R0
        FMOV.S      @(R0,R4),FR5
        MOV         #48,R0
        FMOV.S      @(R0,R4),FR7
        FIPR        FV0,FV4                 ; fr6, never loaded, meets fr2's 0
        FMOV.S      FR7,@R6
        MOV         #4,R0
        FMOV.S      @(R0,R4),FR4
        MOV         #20,R0
        FMOV.S      @(R0,R4),FR5
        MOV         #52,R0
        FMOV.S      @(R0,R4),FR7
        FIPR        FV0,FV4
        MOV         #4,R0
        FMOV.S      FR7,@(R0,R6)
        RTS
        NOP
        .ALIGN      4

; void color_to_argb(Uint32 color, NJS_ARGB *argb)
; write color's channels to argb as floats from 0 to 255
; @asm open: every instruction is one SHC writes for C
_color_to_argb:
        ADD         #16,R5                  ; b, g, r and a, from argb's end
        MOV         #-1,R1
        EXTU.B      R1,R1
        MOV         R1,R0
        AND         R4,R0
        LDS         R0,FPUL
        FLOAT       FPUL,FR0
        FMOV.S      FR0,@-R5
        SHLR8       R4
        MOV         R1,R0
        AND         R4,R0
        LDS         R0,FPUL
        FLOAT       FPUL,FR0
        FMOV.S      FR0,@-R5
        SHLR8       R4
        MOV         R1,R0
        AND         R4,R0
        LDS         R0,FPUL
        FLOAT       FPUL,FR0
        FMOV.S      FR0,@-R5
        SHLR8       R4
        LDS         R4,FPUL
        FLOAT       FPUL,FR0
        RTS
        FMOV.S      FR0,@-R5
        .ALIGN      4

; Uint32 color_from_argb(NJS_ARGB *argb)
; return the color with argb's channels, each truncated. it doesn't mask
; them, so a channel outside 0 to 255 sets bits of the channels above it
; @asm open: every instruction is one SHC writes for C
_color_from_argb:
        FMOV.S      @R4+,FR0
        FTRC        FR0,FPUL
        STS         FPUL,R0
        SHLL16      R0
        SHLL8       R0
        FMOV.S      @R4+,FR0
        FTRC        FR0,FPUL
        STS         FPUL,R1
        SHLL16      R1
        OR          R1,R0
        FMOV.S      @R4+,FR0
        FTRC        FR0,FPUL
        STS         FPUL,R1
        SHLL8       R1
        OR          R1,R0
        FMOV.S      @R4+,FR0
        FTRC        FR0,FPUL
        STS         FPUL,R1
        RTS
        OR          R1,R0

; Uint32 color_multiply(Uint32 color, Uint32 by)
; return each channel of color times by's, over 255 and rounded. it
; multiplies the two as fractions of 1, holds the product to 1, and scales
; it back by 255
; @asm open: every instruction is one SHC writes for C
_color_multiply:
        MOVA        ?per_255,R0
        FMOV.S      @R0,FR0
        MOVA        ?full,R0
        FMOV.S      @R0,FR3
        FLDI1       FR4
        MOVA        ?half,R0
        FMOV.S      @R0,FR5
        MOV         #-1,R3
        EXTU.B      R3,R3
        MOV         R3,R1
        MOV         R3,R2
        AND         R4,R1
        AND         R5,R2
        LDS         R1,FPUL
        FLOAT       FPUL,FR1
        LDS         R2,FPUL
        FLOAT       FPUL,FR2
        FMUL        FR0,FR1
        FMUL        FR0,FR2
        FMUL        FR2,FR1
        FCMP/GT     FR1,FR4
        BT          ?blue
        FMOV.S      FR4,FR1
?blue:
        FMUL        FR3,FR1
        FADD        FR5,FR1
        FTRC        FR1,FPUL
        STS         FPUL,R0
        SHLR8       R4
        SHLR8       R5
        MOV         R3,R1
        MOV         R3,R2
        AND         R4,R1
        AND         R5,R2
        LDS         R1,FPUL
        FLOAT       FPUL,FR1
        LDS         R2,FPUL
        FLOAT       FPUL,FR2
        FMUL        FR0,FR1
        FMUL        FR0,FR2
        FMUL        FR2,FR1
        FCMP/GT     FR1,FR4
        BT          ?green
        FMOV.S      FR4,FR1
?green:
        FMUL        FR3,FR1
        FADD        FR5,FR1
        FTRC        FR1,FPUL
        STS         FPUL,R1
        SHLL8       R1
        OR          R1,R0
        SHLR8       R4
        SHLR8       R5
        MOV         R3,R1
        MOV         R3,R2
        AND         R4,R1
        AND         R5,R2
        LDS         R1,FPUL
        FLOAT       FPUL,FR1
        LDS         R2,FPUL
        FLOAT       FPUL,FR2
        FMUL        FR0,FR1
        FMUL        FR0,FR2
        FMUL        FR2,FR1
        FCMP/GT     FR1,FR4
        BT          ?red
        FMOV.S      FR4,FR1
?red:
        FMUL        FR3,FR1
        FADD        FR5,FR1
        FTRC        FR1,FPUL
        STS         FPUL,R1
        SHLL16      R1
        OR          R1,R0
        SHLR8       R4
        SHLR8       R5
        MOV         R3,R1
        MOV         R3,R2
        AND         R4,R1
        AND         R5,R2
        LDS         R1,FPUL
        FLOAT       FPUL,FR1
        LDS         R2,FPUL
        FLOAT       FPUL,FR2
        FMUL        FR0,FR1
        FMUL        FR0,FR2
        FMUL        FR2,FR1
        FCMP/GT     FR1,FR4
        BT          ?alpha
        FMOV.S      FR4,FR1
?alpha:
        FMUL        FR3,FR1
        FADD        FR5,FR1
        FTRC        FR1,FPUL
        STS         FPUL,R1
        SHLL16      R1
        SHLL8       R1
        RTS
        OR          R1,R0
        .ALIGN      4
?per_255:
        .DATA.L     H'3B808080              ; a hair under 1/255
?full:
        .FDATA.S    F'255.0
?half:
        .FDATA.S    F'0.5

; void color_to_argb_unit(Uint32 color, NJS_ARGB *argb)
; write color's channels to argb as floats from 0 to 1: each byte times a
; hair under 1/255
; @asm open: every instruction is one SHC writes for C
_color_to_argb_unit:
        MOVA        ?per_255,R0
        FMOV.S      @R0,FR3
        ADD         #16,R5
        MOV         #-1,R1
        EXTU.B      R1,R1
        MOV         R1,R0
        AND         R4,R0
        LDS         R0,FPUL
        FLOAT       FPUL,FR0
        FMUL        FR3,FR0
        FMOV.S      FR0,@-R5
        SHLR8       R4
        MOV         R1,R0
        AND         R4,R0
        LDS         R0,FPUL
        FLOAT       FPUL,FR0
        FMUL        FR3,FR0
        FMOV.S      FR0,@-R5
        SHLR8       R4
        MOV         R1,R0
        AND         R4,R0
        LDS         R0,FPUL
        FLOAT       FPUL,FR0
        FMUL        FR3,FR0
        FMOV.S      FR0,@-R5
        SHLR8       R4
        LDS         R4,FPUL
        FLOAT       FPUL,FR0
        FMUL        FR3,FR0
        RTS
        FMOV.S      FR0,@-R5
        .ALIGN      4
?per_255:
        .DATA.L     H'3B808080              ; a hair under 1/255

; Uint32 color_from_argb_unit(NJS_ARGB *argb)
; return the color with argb's channels, from 0 to 1, each times 255 and
; rounded. it doesn't mask them, so a channel that rounds outside 0 to 255
; sets bits of the channels above it
; @asm open: every instruction is one SHC writes for C
_color_from_argb_unit:
        MOVA        ?half,R0
        FMOV.S      @R0,FR2
        MOVA        ?full,R0
        FMOV.S      @R0,FR3
        FMOV.S      @R4+,FR0
        FMOV.S      FR2,FR1
        FMAC        FR0,FR3,FR1             ; fr1 is fr0 fr3 + fr1
        FTRC        FR1,FPUL
        STS         FPUL,R0
        SHLL16      R0
        SHLL8       R0
        FMOV.S      @R4+,FR0
        FMOV.S      FR2,FR1
        FMAC        FR0,FR3,FR1
        FTRC        FR1,FPUL
        STS         FPUL,R1
        SHLL16      R1
        OR          R1,R0
        FMOV.S      @R4+,FR0
        FMOV.S      FR2,FR1
        FMAC        FR0,FR3,FR1
        FTRC        FR1,FPUL
        STS         FPUL,R1
        SHLL8       R1
        OR          R1,R0
        FMOV.S      @R4+,FR0
        FMAC        FR0,FR3,FR2
        FTRC        FR2,FPUL
        STS         FPUL,R1
        RTS
        OR          R1,R0
        .ALIGN      4
?full:
        .FDATA.S    F'255.0
?half:
        .FDATA.S    F'0.5

; void fill_bytes(void *mem, int value, int count)
; set the count bytes at mem to value's low byte, from the last down.
; count must be positive: DT decrements it before testing it, so a count of
; 0 writes 2^32 bytes below mem
; @asm open: every instruction is one SHC writes for C
_fill_bytes:
        ADD         R6,R4
?byte:
        DT          R6
        BF/S        ?byte
        MOV.B       R5,@-R4
        RTS
        NOP

; void fill_blocks(void *mem, Uint32 value, int size)
; set the size bytes at mem to value, eight longs a pass, from the last
; down. size must be a positive multiple of 32, and mem a multiple of 4
; @asm open: no inspect rule reads its SHLD R0,R6
_fill_blocks:
        ADD         R6,R4
        MOV         #-5,R0
        SHLD        R0,R6                   ; the passes, one per 32 bytes
        NOP
?block:
        MOV.L       R5,@-R4
        MOV.L       R5,@-R4
        MOV.L       R5,@-R4
        MOV.L       R5,@-R4
        MOV.L       R5,@-R4
        MOV.L       R5,@-R4
        MOV.L       R5,@-R4
        DT          R6
        BF/S        ?block
        MOV.L       R5,@-R4
        RTS
        NOP

        .END

        .DATA.W     H'2C1F,H'2BF1,H'2BC3,H'2B94,H'2B66,H'2B37,H'2B09,H'2ADA
        .DATA.W     H'2AAB,H'2A7C,H'2A4C,H'2A1D,H'29ED,H'29BE,H'298E,H'295E
        .DATA.W     H'292E,H'28FE,H'28CE,H'289D,H'286D,H'283C,H'280B,H'27DA
        .DATA.W     H'27A9,H'2777,H'2746,H'2714,H'26E2,H'26B0,H'267E,H'264C
        .DATA.W     H'2619,H'25E7,H'25B4,H'2581,H'254D,H'251A,H'24E6,H'24B2
        .DATA.W     H'247E,H'244A,H'2415,H'23E1,H'23AC,H'2376,H'2341,H'230B
        .DATA.W     H'22D6,H'229F,H'2269,H'2232,H'21FC,H'21C4,H'218D,H'2155
        .DATA.W     H'211D,H'20E5,H'20AD,H'2074,H'203B,H'2001,H'1FC7,H'1F8D
        .DATA.W     H'1F53,H'1F18,H'1EDD,H'1EA1,H'1E66,H'1E29,H'1DED,H'1DB0

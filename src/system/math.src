; vector and point math, angle lookups, color conversion and memory fills.
; across means in the x-z plane: an _across function reads x and z and
; ignores y. an angle is in Ninja's units, 65536 to a turn

        .IMPORT     __nj_screen_
        .IMPORT     __nj_scr_aspect_x_
        .IMPORT     __nj_scr_aspect_y_
        .IMPORT     _njExecuteFade
        .IMPORT     _njFadeDisable
        .IMPORT     _njFadeEnable
        .IMPORT     _njSetFadeColor
        .IMPORT     _syCfgExit
        .IMPORT     _syCfgGetSoundMode
        .IMPORT     _syCfgInit
        .IMPORT     _syCfgSetSoundMode
        .EXPORT     _angle_sin_over_abs_cos
        .EXPORT     _vector_inner_product
        .EXPORT     _vector_inner_product_across
        .EXPORT     _vector_outer_product
        .EXPORT     _vector_magnitude
        .EXPORT     _vector_magnitude_across
        .EXPORT     _vector_magnitude_squared
        .EXPORT     _vector_magnitude_squared_across
        .EXPORT     _vector_unit
        .EXPORT     _vector_unit_across
        .EXPORT     _vector_cosine
        .EXPORT     _point_distance
        .EXPORT     _point_distance_across
        .EXPORT     _point_distance_squared
        .EXPORT     _point_distance_squared_across
        .EXPORT     _angle_arc_tan2
        .EXPORT     _point_project_centered
        .EXPORT     _float_mod
        .EXPORT     _angle_arc_sin
        .EXPORT     _angle_arc_cos
        .EXPORT     _point_calc_xy
        .EXPORT     _color_to_argb
        .EXPORT     _color_from_argb
        .EXPORT     _color_multiply
        .EXPORT     _color_to_argb_unit
        .EXPORT     _color_from_argb_unit
        .EXPORT     _fill_bytes
        .EXPORT     _fill_blocks

; a quarter and a half of a turn
QUARTER:        .EQU    H'4000
HALF:           .EQU    H'8000

        .SECTION    P,CODE,ALIGN=32

; the addresses of Ninja's fade calls and Shinobi's configuration calls,
; which the image holds ahead of this file's first function. nothing shows a
; reader of the table: no PC-relative load or MOVA reaches it, and no word in
; the game's programs points into it
        .DATA.L     _njExecuteFade
        .DATA.L     _njFadeEnable
        .DATA.L     _njFadeDisable
        .DATA.L     _njSetFadeColor
        .DATA.L     _syCfgInit
        .DATA.L     _syCfgExit
        .DATA.L     _syCfgSetSoundMode
        .DATA.L     _syCfgGetSoundMode

; Float angle_sin_over_abs_cos(Angle ang)
; return sin(ang) / |cos(ang)|, from FSCA's sine and cosine and FSRRA's
; reciprocal square root. where cos(ang) is negative, that is -tan(ang)
; @asm open: no inspect rule reads the FR0 and FR1 its FSCA leaves in place
_angle_sin_over_abs_cos:
        EXTU.W      R4,R4
        LDS         R4,FPUL
        FSCA        FPUL,DR0
        FMUL        FR1,FR1
        FSRRA       FR1
        RTS
        FMUL        FR1,FR0
        .ALIGN      4

; Float vector_inner_product(NJS_VECTOR *a, NJS_VECTOR *b)
; return a . b. the FIPR at 0x8c08a8be also multiplies FR7, which the
; caller left, by FR3, which the FLDI0 at 0x8c08a8b2 zeroes
; @asm open: no inspect rule reads FV0 and FV4 filled by three loads each before
; its FIPR
_vector_inner_product:
        FMOV.S      @R4+,FR0
        FLDI0       FR3
        FMOV.S      @R4+,FR1
        FMOV.S      @R4+,FR2
        FMOV.S      @R5+,FR4
        FMOV.S      @R5+,FR5
        FMOV.S      @R5+,FR6
        FIPR        FV4,FV0                 ; fr3 is fv4 . fv0
        RTS
        FMOV.S      FR3,FR0

; Float vector_inner_product_across(NJS_VECTOR *a, NJS_VECTOR *b)
; return a . b across. the FIPR at 0x8c08a8d4 also multiplies FR5 and FR7,
; which the caller left, by FR1 and FR3, which the FLDI0s at 0x8c08a8ca and
; 0x8c08a8d2 zero
; @asm open: no inspect rule reads FV0 and FV4 filled by two loads each before
; its FIPR
_vector_inner_product_across:
        FMOV.S      @R4+,FR0
        ADD         #4,R4
        FMOV.S      @R4+,FR2
        FLDI0       FR1
        FMOV.S      @R5+,FR4
        ADD         #4,R5
        FMOV.S      @R5+,FR6
        FLDI0       FR3
        FIPR        FV4,FV0
        RTS
        FMOV.S      FR3,FR0
        .ALIGN      4

; void vector_outer_product(NJS_VECTOR *a, NJS_VECTOR *b, NJS_VECTOR *out)
; write a x b to out, z first. each part is one FIPR FV0,FV4 of two of a's
; parts, the second negated, and two of b's. it also multiplies FR6 and
; FR7, as it finds them, by FR2 and FR3, which the FLDI0s at 0x8c08a8dc and
; 0x8c08a8de zero. out must be neither a nor b: the later parts read the z
; it writes first
; @asm operand: fipr-registers, FIPR FV0,FV4 at 0x8c08a8f0, 0x8c08a902 and
; 0x8c08a914
_vector_outer_product:
        FLDI0       FR2
        FLDI0       FR3
        ADD         #12,R6                  ; z, y and x, down from out's end
        MOV         #0,R0
        FMOV.S      @(R0,R4),FR0
        FMOV.S      @(R0,R5),FR5
        MOV         #4,R0
        FMOV.S      @(R0,R4),FR1
        FNEG        FR1
        FMOV.S      @(R0,R5),FR4
        FIPR        FV0,FV4                 ; a.x b.y - a.y b.x
        FMOV.S      FR7,@-R6
        MOV         #8,R0
        FMOV.S      @(R0,R4),FR0
        FMOV.S      @(R0,R5),FR5
        MOV         #0,R0
        FMOV.S      @(R0,R4),FR1
        FNEG        FR1
        FMOV.S      @(R0,R5),FR4
        FIPR        FV0,FV4                 ; a.z b.x - a.x b.z
        FMOV.S      FR7,@-R6
        MOV         #4,R0
        FMOV.S      @(R0,R4),FR0
        FMOV.S      @(R0,R5),FR5
        MOV         #8,R0
        FMOV.S      @(R0,R4),FR1
        FNEG        FR1
        FMOV.S      @(R0,R5),FR4
        FIPR        FV0,FV4                 ; a.y b.z - a.z b.y
        RTS
        FMOV.S      FR7,@-R6
        .ALIGN      4

; Float vector_magnitude(NJS_VECTOR *vector)
; the vector's length
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08a924
_vector_magnitude:
        FMOV.S      @R4+,FR0
        FLDI0       FR3
        FMOV.S      @R4+,FR1
        FMOV.S      @R4+,FR2
        FIPR        FV0,FV0
        FMOV.S      FR3,FR0
        RTS
        FSQRT       FR0

; Float vector_magnitude_across(NJS_VECTOR *vector)
; the vector's length across
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08a936
_vector_magnitude_across:
        FMOV.S      @R4+,FR0
        ADD         #4,R4
        FMOV.S      @R4+,FR2
        FLDI0       FR1
        FLDI0       FR3
        FIPR        FV0,FV0
        FMOV.S      FR3,FR0
        RTS
        FSQRT       FR0
        .ALIGN      4

; Float vector_magnitude_squared(NJS_VECTOR *vector)
; the square of the vector's length
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08a948
_vector_magnitude_squared:
        FMOV.S      @R4+,FR0
        FLDI0       FR3
        FMOV.S      @R4+,FR1
        FMOV.S      @R4+,FR2
        FIPR        FV0,FV0
        RTS
        FMOV.S      FR3,FR0
        .ALIGN      4

; Float vector_magnitude_squared_across(NJS_VECTOR *vector)
; the square of the vector's length across
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08a95a
_vector_magnitude_squared_across:
        FMOV.S      @R4+,FR0
        ADD         #4,R4
        FMOV.S      @R4+,FR2
        FLDI0       FR1
        FLDI0       FR3
        FIPR        FV0,FV0
        RTS
        FMOV.S      FR3,FR0

; Float vector_unit(NJS_VECTOR *vector, NJS_VECTOR *out)
; normalize vector into out and return the reciprocal of its length, as
; FSRRA approximates it. it doesn't check for a zero length
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08a968
_vector_unit:
        FMOV.S      @R4+,FR0
        FLDI0       FR3
        FMOV.S      @R4+,FR1
        FMOV.S      @R4+,FR2
        FIPR        FV0,FV0
        FSRRA       FR3
        FMUL        FR3,FR0
        FMUL        FR3,FR1
        FMUL        FR3,FR2
        ADD         #12,R5
        FMOV.S      FR2,@-R5
        FMOV.S      FR1,@-R5
        FMOV.S      FR0,@-R5
        RTS
        FMOV.S      FR3,FR0
        .ALIGN      4

; Float vector_unit_across(NJS_VECTOR *vector, NJS_VECTOR *out)
; normalize vector's x and z across into out's, and return the reciprocal
; of their length, as FSRRA approximates it. out->y keeps its value. it
; doesn't check for a zero length
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08a98a
_vector_unit_across:
        FMOV.S      @R4+,FR0
        ADD         #4,R4
        FMOV.S      @R4+,FR2
        FLDI0       FR1
        FLDI0       FR3
        FIPR        FV0,FV0
        FSRRA       FR3
        FMUL        FR3,FR0
        FMUL        FR3,FR2
        ADD         #12,R5
        FMOV.S      FR2,@-R5
        ADD         #-4,R5
        FMOV.S      FR0,@-R5
        RTS
        FMOV.S      FR3,FR0
        .ALIGN      4

; Float vector_cosine(NJS_VECTOR *a, NJS_VECTOR *b)
; return the cosine of the angle between a and b: a . b times the
; reciprocals of their lengths, as FSRRA approximates them
; @asm operand: fipr-registers, FIPR FV4,FV4 at 0x8c08a9a8, FV8,FV8 at
; 0x8c08a9b6 and FV4,FV8 at 0x8c08a9be
_vector_cosine:
        FMOV.S      @R4+,FR4
        FMOV.S      @R4+,FR5
        FMOV.S      @R4+,FR6
        FLDI0       FR7
        FIPR        FV4,FV4
        FSRRA       FR7
        FMOV.S      FR7,FR0
        FMOV.S      @R5+,FR8
        FMOV.S      @R5+,FR9
        FMOV.S      @R5+,FR10
        FLDI0       FR11
        FIPR        FV8,FV8
        FSRRA       FR11
        FMUL        FR11,FR0
        FLDI0       FR7
        FIPR        FV4,FV8
        RTS
        FMUL        FR11,FR0

; Float point_distance(NJS_POINT3 *from, NJS_POINT3 *to)
; the distance between the points
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08a9d8
_point_distance:
        FMOV.S      @R4+,FR0
        FLDI0       FR3
        FMOV.S      @R5+,FR4
        FSUB        FR4,FR0
        FMOV.S      @R4+,FR1
        FMOV.S      @R5+,FR4
        FSUB        FR4,FR1
        FMOV.S      @R4+,FR4
        FMOV.S      @R5+,FR2
        FSUB        FR4,FR2
        FIPR        FV0,FV0
        FMOV.S      FR3,FR0
        RTS
        FSQRT       FR0

; Float point_distance_across(NJS_POINT3 *from, NJS_POINT3 *to)
; the distance between the points, across
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08a9f4
_point_distance_across:
        FMOV.S      @R4+,FR0
        ADD         #4,R4
        FMOV.S      @R5+,FR4
        ADD         #4,R5
        FSUB        FR4,FR0
        FLDI0       FR1
        FMOV.S      @R4+,FR4
        FLDI0       FR3
        FMOV.S      @R5+,FR2
        FSUB        FR4,FR2
        FIPR        FV0,FV0
        FMOV.S      FR3,FR0
        RTS
        FSQRT       FR0

; Float point_distance_squared(NJS_POINT3 *from, NJS_POINT3 *to)
; the square of the distance between the points
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08aa10
_point_distance_squared:
        FMOV.S      @R4+,FR0
        FLDI0       FR3
        FMOV.S      @R5+,FR4
        FSUB        FR4,FR0
        FMOV.S      @R4+,FR1
        FMOV.S      @R5+,FR4
        FSUB        FR4,FR1
        FMOV.S      @R4+,FR4
        FMOV.S      @R5+,FR2
        FSUB        FR4,FR2
        FIPR        FV0,FV0
        RTS
        FMOV.S      FR3,FR0

; Float point_distance_squared_across(NJS_POINT3 *from, NJS_POINT3 *to)
; the square of the distance between the points, across
; @asm operand: fipr-registers, FIPR FV0,FV0 at 0x8c08aa2a
_point_distance_squared_across:
        FMOV.S      @R4+,FR0
        ADD         #4,R4
        FMOV.S      @R5+,FR4
        ADD         #4,R5
        FMOV.S      @R5+,FR2
        FSUB        FR4,FR0
        FMOV.S      @R4+,FR4
        FSUB        FR4,FR2
        FLDI0       FR1
        FLDI0       FR3
        FIPR        FV0,FV0
        RTS
        FMOV.S      FR3,FR0

; Angle angle_arc_tan2(Float y, Float x)
; return the angle from the x axis to (x, y), from -HALF to HALF, or
; H'80000000 when both are 0. the smaller of |x| and |y| over the larger is
; the tangent of an angle up to an eighth of a turn. ?atan_table gives that
; angle, interpolated between two entries and rounded. R1 is the octant's
; offset in ?octants: 8 where x <= 0, 4 more where y <= 0, and 2 more where
; |y| >= |x|. the BRAF at 0x8c08aa92 jumps to the octant's code, which turns
; the angle into the result. ?atan_table's 513 angles, at 0x8c08aaf0, lie
; inside the function, which addresses them by the MOVA at 0x8c08aa76
; @asm open: no inspect rule reads its BRAF through a MOVA table with no range
; check
_angle_arc_tan2:
        FLDI0       FR0
        FCMP/EQ     FR4,FR0
        BF          ?octant
        FCMP/EQ     FR5,FR0
        BF          ?octant
        MOV         #1,R0
        RTS
        ROTR        R0
?octant:
        MOV         #0,R1
        FCMP/GT     FR0,FR5
        BT          ?right
        FABS        FR5
        MOV         #8,R1
?right:
        FCMP/GT     FR0,FR4
        BT          ?upper
        FABS        FR4
        ADD         #4,R1
?upper:
        FCMP/GT     FR4,FR5
        BT          ?ratio
        FMOV.S      FR4,FR0
        FMOV.S      FR5,FR4
        FMOV.S      FR0,FR5
        ADD         #2,R1
?ratio:
        FDIV        FR5,FR4                 ; 0 to 1
        MOVA        ?octants,R0
        MOV.W       @(R0,R1),R1
        MOVA        ?steps,R0
        FMOV.S      @R0,FR1
        FMUL        FR4,FR1
        FTRC        FR1,FPUL
        STS         FPUL,R2                 ; the entry at or under the ratio
        LDS         R2,FPUL
        FLOAT       FPUL,FR2
        FSUB        FR2,FR1                 ; and how far past it
        SHLL        R2
        MOVA        ?atan_table,R0
        MOV.W       @(R0,R2),R4
        ADD         #2,R2
        MOV.W       @(R0,R2),R3
        MOV         R4,R2
        SUB         R2,R3
        LDS         R3,FPUL
        FLOAT       FPUL,FR3
        FMUL        FR1,FR3
        MOVA        ?half,R0
        FMOV.S      @R0,FR0
        FADD        FR0,FR3
        FTRC        FR3,FPUL
        STS         FPUL,R3
        BRAF        R1
        ADD         R3,R2                   ; the angle within the octant
?octant_base:
        RTS                                 ; no octant comes here
        MOV         #0,R0
?octant_0:
        RTS
        MOV         R2,R0
?octant_1:
        MOV.L       ?quarter,R0
        RTS
        SUB         R2,R0
?octant_5:
        MOV.L       ?quarter,R0
        RTS
        ADD         R2,R0
?octant_4:
        MOV.L       ?half_turn,R0
        RTS
        SUB         R2,R0
?octant_6:
        MOV.L       ?half_turn,R0
        SUB         R0,R2
        RTS
        MOV         R2,R0
?octant_7:
        MOV.L       ?back_quarter,R0
        RTS
        SUB         R2,R0
?octant_3:
        MOV.L       ?quarter,R0
        SUB         R0,R2
        RTS
        MOV         R2,R0
?octant_2:
        RTS
        NEG         R2,R0
        .DATA.W     0                       ; the angles start on a long
?quarter:
        .DATA.L     QUARTER
?half_turn:
        .DATA.L     HALF
?back_quarter:
        .DATA.L     -QUARTER
; the offset of each octant's code past ?octant_base, where the BRAF counts
; its jump from
?octants:
        .DATA.W     ?octant_0-?octant_base,?octant_1-?octant_base
        .DATA.W     ?octant_2-?octant_base,?octant_3-?octant_base
        .DATA.W     ?octant_4-?octant_base,?octant_5-?octant_base
        .DATA.W     ?octant_6-?octant_base,?octant_7-?octant_base
?steps:
        .FDATA.S    F'512.0
?half:
        .FDATA.S    F'0.5
; the angle whose tangent is n/512, for n from 0 to 512: up to an eighth of
; a turn
?atan_table:
        .DATA.W     H'0000,H'0014,H'0028,H'003D,H'0051,H'0065,H'007A,H'008E
        .DATA.W     H'00A2,H'00B7,H'00CB,H'00E0,H'00F4,H'0108,H'011D,H'0131
        .DATA.W     H'0145,H'015A,H'016E,H'0182,H'0197,H'01AB,H'01BF,H'01D4
        .DATA.W     H'01E8,H'01FC,H'0211,H'0225,H'0239,H'024E,H'0262,H'0276
        .DATA.W     H'028B,H'029F,H'02B3,H'02C7,H'02DC,H'02F0,H'0304,H'0318
        .DATA.W     H'032D,H'0341,H'0355,H'0369,H'037E,H'0392,H'03A6,H'03BA
        .DATA.W     H'03CE,H'03E3,H'03F7,H'040B,H'041F,H'0433,H'0448,H'045C
        .DATA.W     H'0470,H'0484,H'0498,H'04AC,H'04C0,H'04D4,H'04E8,H'04FD
        .DATA.W     H'0511,H'0525,H'0539,H'054D,H'0561,H'0575,H'0589,H'059D
        .DATA.W     H'05B1,H'05C5,H'05D9,H'05ED,H'0601,H'0614,H'0628,H'063C
        .DATA.W     H'0650,H'0664,H'0678,H'068C,H'06A0,H'06B3,H'06C7,H'06DB
        .DATA.W     H'06EF,H'0703,H'0716,H'072A,H'073E,H'0752,H'0765,H'0779
        .DATA.W     H'078D,H'07A0,H'07B4,H'07C8,H'07DB,H'07EF,H'0803,H'0816
        .DATA.W     H'082A,H'083D,H'0851,H'0864,H'0878,H'088B,H'089F,H'08B2
        .DATA.W     H'08C6,H'08D9,H'08ED,H'0900,H'0913,H'0927,H'093A,H'094D
        .DATA.W     H'0961,H'0974,H'0987,H'099B,H'09AE,H'09C1,H'09D4,H'09E8
        .DATA.W     H'09FB,H'0A0E,H'0A21,H'0A34,H'0A47,H'0A5A,H'0A6D,H'0A80
        .DATA.W     H'0A94,H'0AA7,H'0ABA,H'0ACD,H'0AE0,H'0AF2,H'0B05,H'0B18
        .DATA.W     H'0B2B,H'0B3E,H'0B51,H'0B64,H'0B77,H'0B89,H'0B9C,H'0BAF
        .DATA.W     H'0BC2,H'0BD4,H'0BE7,H'0BFA,H'0C0C,H'0C1F,H'0C32,H'0C44
        .DATA.W     H'0C57,H'0C69,H'0C7C,H'0C8E,H'0CA1,H'0CB3,H'0CC6,H'0CD8
        .DATA.W     H'0CEB,H'0CFD,H'0D0F,H'0D22,H'0D34,H'0D46,H'0D58,H'0D6B
        .DATA.W     H'0D7D,H'0D8F,H'0DA1,H'0DB4,H'0DC6,H'0DD8,H'0DEA,H'0DFC
        .DATA.W     H'0E0E,H'0E20,H'0E32,H'0E44,H'0E56,H'0E68,H'0E7A,H'0E8C
        .DATA.W     H'0E9E,H'0EAF,H'0EC1,H'0ED3,H'0EE5,H'0EF7,H'0F08,H'0F1A
        .DATA.W     H'0F2C,H'0F3D,H'0F4F,H'0F61,H'0F72,H'0F84,H'0F95,H'0FA7
        .DATA.W     H'0FB8,H'0FCA,H'0FDB,H'0FED,H'0FFE,H'1010,H'1021,H'1032
        .DATA.W     H'1044,H'1055,H'1066,H'1077,H'1089,H'109A,H'10AB,H'10BC
        .DATA.W     H'10CD,H'10DE,H'10EF,H'1100,H'1111,H'1122,H'1133,H'1144
        .DATA.W     H'1155,H'1166,H'1177,H'1188,H'1199,H'11A9,H'11BA,H'11CB
        .DATA.W     H'11DC,H'11EC,H'11FD,H'120E,H'121E,H'122F,H'123F,H'1250
        .DATA.W     H'1260,H'1271,H'1281,H'1292,H'12A2,H'12B3,H'12C3,H'12D3
        .DATA.W     H'12E4,H'12F4,H'1304,H'1314,H'1325,H'1335,H'1345,H'1355
        .DATA.W     H'1365,H'1375,H'1385,H'1395,H'13A5,H'13B5,H'13C5,H'13D5
        .DATA.W     H'13E5,H'13F5,H'1405,H'1415,H'1424,H'1434,H'1444,H'1454
        .DATA.W     H'1463,H'1473,H'1483,H'1492,H'14A2,H'14B1,H'14C1,H'14D0
        .DATA.W     H'14E0,H'14EF,H'14FF,H'150E,H'151E,H'152D,H'153C,H'154C

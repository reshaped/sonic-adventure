+/* the port: a static buffer's loop start, in samples (blocks, for ADPCM)
+ * from its start, as CFG_BUF_LBO takes it, for a sound that plays its start
+ * once and then loops a later part of itself, as the Dreamcast AICA's
+ * channels do from LSA to LEA. nxAudioBufferSubmit sets it to 0 */
+bool nxAudioVoiceSetLoopStart (nxAudioVoice *voice, uint32_t sample)
+{
+    if (!voice) {
+        apu_set_last_error(NX_AUDIO_ERR_INVALID_PARAM);
+        return false;
+    }
+
+    const KIRQL irql = KeRaiseIrqlToDpcLevel();
+    apu_wait_for_pio(4);
+    apu_write_reg(APU_VP_OFFSET + NV1BA0_PIO_SET_CURRENT_VOICE, voice->voice_index);
+    apu_write_reg(APU_VP_OFFSET + NV1BA0_PIO_VOICE_LOCK, 1);
+    apu_write_reg(APU_VP_OFFSET + NV1BA0_PIO_SET_VOICE_CFG_BUF_LBO, sample);
+    apu_write_reg(APU_VP_OFFSET + NV1BA0_PIO_VOICE_LOCK, 0);
+    KfLowerIrql(irql);
+    return true;
+}

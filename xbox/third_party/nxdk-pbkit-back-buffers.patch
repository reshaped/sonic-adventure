diff --git a/lib/pbkit/pbkit.c b/lib/pbkit/pbkit.c
index 428c709..e78acc6 100644
--- a/lib/pbkit/pbkit.c
+++ b/lib/pbkit/pbkit.c
@@ -142,6 +142,7 @@ static  DWORD           pb_FBVFlag;
 static  DWORD           pb_GPUFrameBuffersFormat;//encoded format for GPU
 static  DWORD           pb_EXAddr[8];       //extra buffers addresses
 static  DWORD           pb_ExtraBuffersCount=0;
+static  DWORD           pb_BackBuffersCount=2; //back buffers, pb_back_buffers: 2 is triple buffering
 
 static  DWORD           pb_DepthStencilAddr;
 static  DWORD           pb_DepthStencilPitch;
@@ -1752,6 +1753,14 @@ DWORD pb_wait_for_vbl(void)
 
 
 
+void pb_back_buffers(int n)
+{
+    if (n<1 || n>2)
+        debugPrint("Back buffers must be 1 or 2\n");
+    else
+        pb_BackBuffersCount=n;
+}
+
 void pb_extra_buffers(int n)
 {
     if (n>MAX_EXTRA_BUFFERS)
@@ -2025,7 +2034,7 @@ int pb_finished(void)
 
     //insert in push buffer the commands to trigger selection of next back buffer
     //(because previous ones may not have finished yet, so need to use 0x0100 call)
-    pb_back_index=(pb_back_index+1)%3;
+    pb_back_index=(pb_back_index+1)%pb_FrameBuffersCount;
     pb_target_back_buffer();
 
     return 0;
@@ -2927,7 +2936,7 @@ int pb_init(void)
     Width=vm.width;
     Height=vm.height;
 
-    BackBufferCount=2;          //triple buffering technic!
+    BackBufferCount=pb_BackBuffersCount;  //2 by default: triple buffering technic!
                         //allows dynamic details adjustment
 
     pb_FrameBuffersCount=BackBufferCount+1; //front buffer + back buffers
diff --git a/lib/pbkit/pbkit.h b/lib/pbkit/pbkit.h
index 6c1b819..96cefdf 100644
--- a/lib/pbkit/pbkit.h
+++ b/lib/pbkit/pbkit.h
@@ -56,6 +56,7 @@ int pb_finished(void);  //prepare screen swapping at VBlank (do it at frame end)
 void pb_wait_until_gr_not_busy(void);
 DWORD pb_wait_until_tiles_not_busy(void);
 
+void    pb_back_buffers(int n);//1 for double buffering, 2 (the default) for triple (call it before pb_init)
 void    pb_extra_buffers(int n);//requests additional back buffers (default is 0) (call it before pb_init)
